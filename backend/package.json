{
  "name": "backend",
  "version": "0.0.1",
  "description": "Task tracker API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "prisma generate && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --enable-source-maps dist/main.js",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "npm test -- --watch",
    "test:cov": "npm test -- --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config test/jest-e2e.config.mjs",
    "prestart:dev": "prisma generate",
    "prestart:debug": "prisma generate",
    "prestart": "prisma generate",
    "lint:fix": "npm run lint -- --fix",
    "env:init": "node scripts/init-env.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "pretest": "prisma generate",
    "pretest:e2e": "prisma generate",
    "test:integration": "node --env-file=.env scripts/check-database.mjs",
    "docker:up": "docker compose up --build -d --wait",
    "docker:down": "docker compose down",
    "audit:prod": "npm audit --omit=dev --omit=optional",
    "test:redis": "node --env-file=.env scripts/check-redis.mjs",
    "test:domain": "npm run build && node scripts/check-domain.mjs",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.0",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/passport": "12.0.1",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.10",
    "ioredis": "6.0.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.2",
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.5.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "type": "module"
}
