# Prefer `npm run env:init`: it generates unique URL-safe passwords in .env.
# Never commit .env. Production should inject credentials from a secret manager.
POSTGRES_PASSWORD=
POSTGRES_MIGRATION_PASSWORD=
POSTGRES_APP_PASSWORD=

API_PORT=3001
POSTGRES_PORT=5432
NODE_ENV=development
PORT=3001
DATABASE_POOL_SIZE=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# Local Nest/CLI only. Compose provides its own URLs using host `postgres`.
DATABASE_URL=postgresql://task_tracker_app:REPLACE_WITH_APP_PASSWORD@127.0.0.1:5432/task_tracker
MIGRATION_DATABASE_URL=postgresql://task_tracker_migrator:REPLACE_WITH_MIGRATION_PASSWORD@127.0.0.1:5432/task_tracker?schema=public
# For migrate dev only; create this separate database as described in README.
# SHADOW_DATABASE_URL=postgresql://task_tracker_migrator:REPLACE_WITH_MIGRATION_PASSWORD@127.0.0.1:5432/task_tracker_shadow?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=5000

# Random secret of at least 32 characters; no public/default value.
JWT_SECRET=
# Frontend and Swagger origins, no trailing slash. Use HTTPS in production.
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# Canonical public API origin for invitation links; HTTPS in production.
PUBLIC_API_URL=http://localhost:3001
